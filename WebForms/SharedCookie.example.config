<?xml version="1.0" encoding="utf-8"?>
<!--
  Plantilla de SharedCookie.config (archivo real ignorado por git y excluido del paquete de publicación).
  Web.config lo incluye con <appSettings file="SharedCookie.config">.
  Copiar como SharedCookie.config y completar con los valores del ambiente. Nunca commitear el archivo real.

  Cada clave puede reemplazarse por una variable de entorno (tiene prioridad):
    SharedCookieName            <- SharedCookie__Name
    SharedCookieApplicationName <- SharedCookie__ApplicationName
    SharedCookiePath            <- SharedCookie__Path
    AuthWebBaseUrl              <- AuthWeb__BaseUrl
    AuthWebClientId             <- AuthWeb__ClientId
  Los valores deben coincidir con la configuración SharedCookie de Auth.Web, SAI y SAF.
-->
<appSettings>
  <!-- Nombre de la cookie de autenticación compartida (obligatorio). -->
  <add key="SharedCookieName" value=".AspNetCore.SharedCookie" />
  <!-- ApplicationName de DataProtection compartido con Auth.Web (obligatorio). -->
  <add key="SharedCookieApplicationName" value="NombreAplicacionCompartida" />
  <!-- Path de la cookie. Opcional, por defecto "/". -->
  <add key="SharedCookiePath" value="/" />
  <!-- URL base de Auth.Web, sin barra final. Se usa para login, logout y /api/permissions/version. -->
  <add key="AuthWebBaseUrl" value="https://auth.ejemplo.local" />
  <!-- ClientId con el que IVC está registrado en Auth.Web. -->
  <add key="AuthWebClientId" value="ivc" />
</appSettings>
