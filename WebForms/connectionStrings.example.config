<?xml version="1.0" encoding="utf-8"?>
<!--
  Plantilla de connectionStrings.config (archivo real ignorado por git y excluido del paquete de publicación).
  Copiar este archivo como connectionStrings.config en la misma carpeta y completar los valores del servidor.
  Nunca commitear el archivo real.

  Nombres que lee el código hoy:
    - IVC_TEST / IVC_PROD          -> Dominio/IVCdbContext.cs (Entity Framework). La rama dev usa IVC_TEST y main usa IVC_PROD.
    - ConnectionStringTest / Prod  -> Negocio/AccesoDatos.cs (ADO.NET clásico). Misma convención por rama.
    - AuthWebConnection            -> Dominio/DataProtectionKeysDbContext.cs (anillo de claves compartido con Auth.Web).
-->
<connectionStrings>
  <add name="IVC_TEST"
       connectionString="Data Source=SERVIDOR\INSTANCIA;Initial Catalog=IVC;Integrated Security=True;Encrypt=False"
       providerName="System.Data.SqlClient" />
  <add name="IVC_PROD"
       connectionString="Data Source=SERVIDOR\INSTANCIA;Initial Catalog=IVC;Integrated Security=True;Encrypt=False"
       providerName="System.Data.SqlClient" />
  <add name="ConnectionStringTest"
       connectionString="Data Source=SERVIDOR\INSTANCIA;Initial Catalog=IVC;Integrated Security=True;Encrypt=False"
       providerName="System.Data.SqlClient" />
  <add name="ConnectionStringProd"
       connectionString="Data Source=SERVIDOR\INSTANCIA;Initial Catalog=IVC;Integrated Security=True;Encrypt=False"
       providerName="System.Data.SqlClient" />
  <add name="AuthWebConnection"
       connectionString="Data Source=SERVIDOR\INSTANCIA;Initial Catalog=AuthWeb;Integrated Security=True;Encrypt=False"
       providerName="System.Data.SqlClient" />
</connectionStrings>
